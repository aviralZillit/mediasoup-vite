# ==========================================
# Backend Connection
# ==========================================
# Which mediasoup server to connect to.
# Options: local | dev | qa | prod | wss://custom-host:port
#   local → wss://localhost:4443 (local dev with self-signed cert)
#   dev   → wss://meet-dev.zillit.com
#   qa    → wss://meet-qa.zillit.com
#   prod  → wss://meet.zillit.com
# If not set, uses the browser's current hostname (original behavior).
VITE_BACKEND_URL=local

# ==========================================
# TURN Server Configuration
# ==========================================
# External TURN server IP/hostname (where zillit_stun_server is running)
# For local dev: Use the IP of the machine running zillit_stun_server
# For production: Use the public IP of your TURN server
VITE_TURN_SERVER_IP=127.0.0.1

# TURN server username (must match zillit_stun_server configuration)
VITE_TURN_USERNAME=zillit

# TURN server password (must match zillit_stun_server configuration)
VITE_TURN_PASSWORD=secure_password_123

# TURN server ports
VITE_TURN_PORT=3478
VITE_TURN_TLS_PORT=5349
