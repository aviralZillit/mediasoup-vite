# MediaSoup Server Configuration

# CNC Database Connection
MONGO_URI=mongodb://localhost:27017/zillit_cnc

# MediaSoup Configuration
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

# HTTPS Configuration
HTTPS_CERT_FULLCHAIN=/path/to/fullchain.pem
HTTPS_CERT_PRIVKEY=/path/to/privkey.pem

# Worker Configuration
WORKER_CERT_FULLCHAIN=/path/to/worker/fullchain.pem
WORKER_CERT_PRIVKEY=/path/to/worker/privkey.pem

# Debug Configuration
DEBUG=*INFO* *WARN* *ERROR*
INTERACTIVE=true

# Protoo WebSocket Port
PROTOO_LISTEN_PORT=4443
