# MediaSoup Server Configuration

# CNC Database Connection
MONGO_URI=mongodb://localhost:27017/zillit_cnc

# MediaSoup Configuration
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

# HTTPS Configuration
HTTPS_CERT_FULLCHAIN=/path/to/fullchain.pem
HTTPS_CERT_PRIVKEY=/path/to/privkey.pem

# Worker Configuration
WORKER_CERT_FULLCHAIN=/path/to/worker/fullchain.pem
WORKER_CERT_PRIVKEY=/path/to/worker/privkey.pem

# Debug Configuration
DEBUG=*INFO* *WARN* *ERROR*
INTERACTIVE=true

# Protoo WebSocket Port
PROTOO_LISTEN_PORT=4443

# Recording Configuration
RECORDING_ENABLED=true
RECORDING_PATH=./recordings
GSTREAMER_DEBUG_LEVEL=3

# AWS Configuration (for MediaConvert high-quality encoding)
# Set USE_MEDIACONVERT=true to enable cloud-based encoding after local FFmpeg composition
USE_MEDIACONVERT=false
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-mediasoup-recordings-bucket

# MediaConvert Role ARN - Required if USE_MEDIACONVERT=true
# Create this role with S3 read/write permissions for MediaConvert
# See AWS-MEDIACONVERT-SETUP.md for instructions
MEDIACONVERT_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/MediaConvertRole

# Optional: MediaConvert endpoint (auto-discovered if not set)
# MEDIACONVERT_ENDPOINT=https://xxxxx.mediaconvert.us-east-1.amazonaws.com

# AWS Credentials (if not using IAM role on EC2)
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
